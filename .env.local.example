# ─── Wireless Connect — Environment Variables ───────────────────────────────
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it is in .gitignore.
#
# Security rules (Technical Architecture Document §8):
# - Only NEXT_PUBLIC_ prefixed vars are safe for browser access.
# - All others are server-only.
# - SELLER_ID_ENCRYPTION_KEY and SUPABASE_SERVICE_ROLE_KEY must NEVER
#   appear in client bundles, logs, or error responses.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API in Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role key — SERVER ONLY. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Stripe Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret — Stripe Dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Enable Stripe Tax for automatic multi-state sales tax (required for nationwide selling)
STRIPE_TAX_ENABLED=true

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Resend Dashboard → API Keys
RESEND_API_KEY=re_...

# From address for transactional emails (must be a verified Resend domain)
EMAIL_FROM=Wireless Connect <no-reply@wirelessconnectnw.com>

# Admin notification email (receives new order alerts)
ADMIN_EMAIL=officialwirelessconnect@gmail.com

# ─── Localization ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es

# ─── Compliance — Seller ID Encryption ───────────────────────────────────────
# Used for pgp_sym_encrypt on device_intakes.seller_id_number_encrypted
# Required for Washington State RCW 19.60 secondhand dealer compliance.
# Generate a strong random key: openssl rand -base64 32
# SERVER ONLY — must never be exposed in client bundles or logs.
SELLER_ID_ENCRYPTION_KEY=generate-a-strong-random-key-here

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
# Required for auth and coupon endpoint rate limiting in production.
# Upstash Console → Redis → REST API
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Future / Optional ────────────────────────────────────────────────────────
# SHIPPO_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# GOOGLE_MAPS_API_KEY=
# IMEI_CHECK_API_KEY=
# OFAC_SCREENING_API_KEY=
